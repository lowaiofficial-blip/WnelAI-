# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter models (DeepSeek R1, Qwen).
# Users configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GROQ_API_KEY: Optional ultra-fast inference (DeepSeek R1 Distill, Llama 3.3).
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TEST_ACCESS_CODE: Optional test access code (defaults to 9317)
TEST_ACCESS_CODE="9317"

# STATUS_API_KEY: Secret key used to authenticate health status data with the status monitor on Render.
STATUS_API_KEY="benim_gizli_anahtarim_9988"

# RESEND_API_KEY: Resend API Key used to reliably send 4-digit verification codes to admin (bypasses Render SMTP port blocks via HTTPS API)
RESEND_API_KEY=""

# ADMIN_EMAIL: The destination email address for verification codes (defaults to golabsdestek@outlook.com)
ADMIN_EMAIL="golabsdestek@outlook.com"
