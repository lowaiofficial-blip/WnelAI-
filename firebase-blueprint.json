{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with customizable settings and status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "bio": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "plan": { "type": "string", "enum": ["free", "go"] },
        "thinkingCooldownUntil": { "type": "number" },
        "thinkingUsesToday": { "type": "number" },
        "thinkingLastUsedDate": { "type": "string" },
        "chatCountToday": { "type": "number" },
        "chatLastDate": { "type": "string" },
        "voiceSecondsUsedToday": { "type": "number" },
        "voiceLastUsedDate": { "type": "string" },
        "isEmailVerified": { "type": "boolean" },
        "settings": { "type": "object" }
      },
      "required": ["email"]
    },
    "EmailVerification": {
      "title": "EmailVerification",
      "description": "4-digit admin-relayed email verification codes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "code": { "type": "string", "maxLength": 4, "minLength": 4 },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "number" },
        "attempts": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "isUsed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "verified", "expired", "failed"] }
      },
      "required": ["userId", "email", "code", "expiresAt", "attempts", "isUsed", "status"]
    },
    "VipClaim": {
      "title": "VipClaim",
      "description": "TikTok VIP campaign application for first 5 users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "orderNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["userId", "email", "orderNumber", "status"]
    },
    "VipCampaign": {
      "title": "VipCampaign",
      "description": "Campaign counter tracking atomic quota claims",
      "type": "object",
      "properties": {
        "claimedCount": { "type": "number" },
        "maxClaims": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["claimedCount", "maxClaims"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin access record",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "addedBy": { "type": "string" }
      },
      "required": ["email"]
    },
    "Chat": {
      "title": "Chat",
      "description": "User chat sessions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isPinned": { "type": "boolean" }
      },
      "required": ["userId", "title"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a chat",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "ai"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Firebase Trigger Email extension collection",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "text": { "type": "string" },
            "html": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["to", "message"]
    },
    "BrandingSettings": {
      "title": "BrandingSettings",
      "description": "Customizable branding assets (logo, favicon)",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/settings/{settingId}": {
      "schema": "BrandingSettings",
      "description": "Global application branding settings"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin privileges collection"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "User chats collection"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside a chat"
    },
    "/vipClaims/{userId}": {
      "schema": "VipClaim",
      "description": "VIP campaign user applications"
    },
    "/vipCampaign/{campaignId}": {
      "schema": "VipCampaign",
      "description": "Campaign quota tracker"
    },
    "/emailVerifications/{userId}": {
      "schema": "EmailVerification",
      "description": "User email verification record and 4-digit pin"
    },
    "/mail/{mailId}": {
      "schema": "Mail",
      "description": "Firebase Trigger Email dispatch queue"
    }
  }
}
